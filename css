/* Kowadło */
.mp-anvil {
  width: 160px;
  height: 50px;
  background: #555;
  border-radius: 10px;
  position: relative;
  margin-top: 60px;
  opacity: 0.75;
}

.mp-anvil::before {
  content: "";
  position: absolute;
  top: -20px;
  left: 40px;
  width: 80px;
  height: 20px;
  background: #666;
  border-radius: 6px;
  opacity: 0.75;
}

/* Młotek */
.mp-hammer {
    position: absolute;
    width: 18px;
    height: 110px;
    background: #8b5a2b;
    right: -39px;
    top: -140px;
    transform-origin: bottom center;
    transform: translateX(-50%) rotate(25deg);
    animation: hammerHit 1.1s infinite ease-in-out;
}

.mp-hammer::before {
  content: "";
  position: absolute;
  top: -28px;
  left: -28px;
  width: 74px;
  height: 28px;
  background: #aaa;
  border-radius: 6px;
}

/* REALISTYCZNE UDERZENIE */
@keyframes hammerHit {
  0% {
    transform: translateX(-50%) translateY(0) rotate(25deg);
  }
  35% {
    transform: translateX(-50%) translateY(30px) rotate(-55deg);
  }
  45% {
    transform: translateX(-50%) translateY(36px) rotate(-65deg);
  }
  55% {
    transform: translateX(-50%) translateY(30px) rotate(-50deg);
  }
  100% {
    transform: translateX(-50%) translateY(0) rotate(25deg);
  }
}


